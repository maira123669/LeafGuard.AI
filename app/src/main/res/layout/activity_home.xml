<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3FAF2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/leaf_logo"
                android:contentDescription="LeafGuard logo"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LeafGuard AI"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#245C2A"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Plant Health Assistant"
                    android:textSize="12sp"
                    android:textColor="#777777"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Welcome -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome! 🌿"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#245C2A"
            android:layout_marginTop="28dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Let's check the health of your plant."
            android:textSize="15sp"
            android:textColor="#666666"
            android:layout_marginTop="6dp"/>

        <!-- Detection heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Leaf Disease Detection"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#245C2A"
            android:layout_marginTop="28dp"/>

        <!-- Image preview -->
        <ImageView
            android:id="@+id/leafImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="15dp"
            android:background="#DDEEDD"
            android:scaleType="centerCrop"
            android:contentDescription="Selected plant leaf"/>

        <!-- Select image -->
        <Button
            android:id="@+id/selectButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SELECT LEAF IMAGE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#388E3C"
            android:layout_marginTop="16dp"/>

        <!-- Analyze -->
        <Button
            android:id="@+id/analyzeButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="ANALYZE WITH AI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#245C2A"
            android:layout_marginTop="10dp"/>

        <!-- Result heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detection Result"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#245C2A"
            android:layout_marginTop="28dp"/>

        <!-- Result area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="#E4F3E2"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your plant disease prediction will appear here."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#245C2A"/>

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Confidence: --"
                android:textSize="14sp"
                android:textColor="#555555"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Powered by TensorFlow Lite"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>
</ScrollView>