<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5FFF5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/leaf_logo"
            android:contentDescription="LeafGuard logo"
            android:layout_marginTop="45dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textColor="#245C2A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login to LeafGuard AI"
            android:textColor="#666666"
            android:textSize="16sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp" />

        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:backgroundTint="#2E7D32" />

        <EditText
            android:id="@+id/passwordInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter your password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#2E7D32" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LOGIN"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            android:layout_marginTop="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI-powered plant health protection"
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="30dp" />

    </LinearLayout>
</ScrollView>